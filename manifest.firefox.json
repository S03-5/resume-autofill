{
  "manifest_version": 3,
  "name": "简历助手",
  "version": "2.4.1",
  "description": "在 BOSS直聘、智联招聘、前程无忧、拉勾、猎聘、实习僧、Moka、北森等招聘网站上自动填写简历内容，支持组件型表单、简历识别、多套简历方案与投递台账。",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus", "windows"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["user-defaults.js", "defaults.js", "profiles.js", "background.js"]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/lexicon.js", "content/matcher.js", "content/sites.js", "content/widgets.js", "content/blocks.js", "content/memory.js", "content/infer.js", "content/ledger.js", "content/hud.js", "content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "fill-current-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "用简历数据填写当前页面的表单"
    },
    "undo-fill": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z"
      },
      "description": "撤销上一次填写，恢复填写前的原值"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jianli-autofill@local",
      "strict_min_version": "115.0"
    }
  }
}
